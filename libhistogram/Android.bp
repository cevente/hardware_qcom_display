cc_library_shared {
    name: "libhistogram",
    vendor: true,

    shared_libs: [
        "libdrm",
        "liblog",
        "libcutils",
        "libutils",
        "libbase",
    ],
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
    ],

    cflags: [
        "-DLOG_TAG=\"SDM-histogram\"",
        "-Wall",
        "-std=c++14",
        "-Werror",
        "-fno-operator-names",
        "-Wthread-safety",
        "-O3",
        "-flto",          // Link-time optimization
        "-funroll-loops",  // Unroll loops where beneficial
        "-fomit-frame-pointer",
        "-ffast-math",     // Fast math optimizations (safe for histogram)
        "-D__ARM_NEON",    // Enable NEON by default
        // Keep -fno-exceptions which is the Android default
    ],

    // Architecture-specific flags - let build system handle tuning
    arch: {
        arm: {
            cflags: [
                "-mfpu=neon",
                "-D__ARM_NEON",
            ],
        },
        arm64: {
            cflags: [
                "-D__ARM_NEON",
            ],
        },
    },

    // For big.LITTLE optimization (Cortex-A73/A53 mix)
    target: {
        android_arm: {
            cflags: [
                "-march=armv8-a",  // Base ARMv8-A, compatible with A73/A53
            ],
        },
        android_arm64: {
            cflags: [
                "-march=armv8-a",
            ],
        },
    },

    srcs: [
        "histogram_collector.cpp",
        "ringbuffer.cpp",
    ],

    strip: {
        keep_symbols: false,
    },
}

cc_binary {
    name: "color_sampling_tool",

    srcs: ["color_sampling_tool.cpp"],
    shared_libs: [
        "libhistogram",
        "libdrm",
        "liblog",
        "libcutils",
        "libutils",
        "libbase",
    ],
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
    ],

    cflags: [
        "-DLOG_TAG=\"SDM-histogram\"",
        "-Wall",
        "-std=c++14",
        "-Werror",
        "-fno-operator-names",
        "-Wthread-safety",
        "-O3",
        "-flto",
        "-funroll-loops",
        "-fomit-frame-pointer",
        "-D__ARM_NEON",
    ],

    arch: {
        arm: {
            cflags: ["-mfpu=neon"],
        },
    },

    vendor: true,
}

cc_binary {
    name: "color_sampling_test",

    srcs: ["ringbuffer_test.cpp"],
    static_libs: [
        "libgtest",
        "libgmock",
    ],
    shared_libs: [
        "libhistogram",
        "libdrm",
        "liblog",
        "libcutils",
        "libutils",
        "libbase",
    ],
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
    ],

    cflags: [
        "-DLOG_TAG=\"SDM-histogram\"",
        "-Wall",
        "-std=c++14",
        "-Werror",
        "-fno-operator-names",
        "-Wthread-safety",
        "-O2",
    ],

    vendor: true,
}
